# ── RAG provider ────────────────────────────────────────────────────────────────
# Choose 'ollama' (default, local, no API key) or 'openai' for each independently.
# WARNING: changing EMBEDDING_PROVIDER requires re-running the embeddings service
# to rebuild the FAISS index — OpenAI (1536-dim) and Ollama (384-dim) are incompatible.
LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama

# ── Ollama settings (used by default — no API key needed) ────────────────────────
OLLAMA_HOST=http://ollama:11434
OLLAMA_LLM_MODEL=llama3.2:1b
OLLAMA_EMBEDDING_MODEL=all-minilm:l6

# ── OpenAI (only needed if you switch LLM_PROVIDER/EMBEDDING_PROVIDER to 'openai') ─
OPENAI_API_KEY=your_openai_api_key_here

# ── PostgreSQL credentials ───────────────────────────────────────────────────────
POSTGRES_USER=carms
POSTGRES_PASSWORD=carms
POSTGRES_DB=carms_db

# Application database URL (must match the credentials above)
DATABASE_URL=postgresql+psycopg2://carms:carms@db:5432/carms_db

# ── Optional overrides ───────────────────────────────────────────────────────────
# OPENAI_LLM_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# DATA_DIR=/data
# FAISS_PATH=/data/embeddings/faiss_index
# CORS_ORIGINS=http://localhost:8501
