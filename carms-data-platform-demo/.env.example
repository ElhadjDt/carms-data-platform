# Required: OpenAI API key for embeddings and Q&A
OPENAI_API_KEY=your_openai_api_key_here

# PostgreSQL credentials (used by both the db service and application services)
POSTGRES_USER=carms
POSTGRES_PASSWORD=carms
POSTGRES_DB=carms_db

# Application database URL (must match the credentials above)
DATABASE_URL=postgresql+psycopg2://carms:carms@db:5432/carms_db

# Optional: override data and FAISS index paths
# DATA_DIR=/data
# FAISS_PATH=/data/embeddings/faiss_index

# Optional: comma-separated allowed origins for CORS (defaults to Streamlit dashboard)
# CORS_ORIGINS=http://localhost:8501
