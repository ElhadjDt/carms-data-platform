# -----------------------------
# Environment variables
# -----------------------------
.env
**/.env

# -----------------------------
# Python cache
# -----------------------------
__pycache__/
*.pyc
*.pyo
*.pyd

# -----------------------------
# Virtual environments
# -----------------------------
venv/
.venv/

# -----------------------------
# FAISS index and embeddings
# -----------------------------
*.faiss
index.faiss
data/embeddings/

# Prebuilt Ollama-mode FAISS index shipped with the repo for instant setup
# (see carms-data-platform-demo/README quick start) - not runtime-generated output.
!carms-data-platform-demo/prebuilt_faiss/
!carms-data-platform-demo/prebuilt_faiss/**

# -----------------------------
# OS junk files
# -----------------------------
.DS_Store

# Ignore extracted files (they will be extracter from raw)
data/extracted/*

# Ignore Python files inside data/raw
data/raw/*.py
